{
  "name": "beekeep",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/main.ts",
    "build": "vite build web --outDir ../dist --emptyOutDir",
    "test": "vitest run",
    "test:live": "node --disable-warning=ExperimentalWarning scripts/live-check.ts",
    "postinstall": "node scripts/postinstall.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.332",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/headless": "^6.0.0",
    "ink": "^8.0.0",
    "node-pty": "^1.1.0",
    "puppeteer-core": "^25.18.1",
    "react": "^19.3.1",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.3",
    "@types/react": "^19.3.2",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "dockview-react": "^8.9.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "description": "Lead a team of Claude Code agents from your terminal: a queen that plans, workers you can watch live, and one place for every approval.",
  "bin": {
    "beekeep": "bin/beekeep"
  },
  "license": "MIT"
}
