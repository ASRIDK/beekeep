#!/usr/bin/env bash
# Starts Beekeep if it is not running, then opens its screen in this terminal.
#   beekeep          the terminal screen
#   beekeep window   the full window in your browser
#   beekeep stop     stop it (bees keep their memory)
#   beekeep help     everything else
set -euo pipefail

self="${BASH_SOURCE[0]}"
while [ -L "$self" ]; do
  link="$(readlink "$self")"
  case "$link" in /*) self="$link" ;; *) self="$(dirname "$self")/$link" ;; esac
done
root="$(cd "$(dirname "$self")/.." && pwd)"

# Installed from npm, Beekeep runs compiled JavaScript; from a clone, its TypeScript.
if [ -f "$root/lib/server/cli.js" ]; then
  entry="$root/lib/server/cli.js"
  need=22
else
  entry="$root/server/cli.ts"
  need=24
fi

major() { "$1" -p 'process.versions.node.split(".")[0]' 2>/dev/null || echo 0; }
node=""
for candidate in "$(command -v node || true)" "$HOME"/.nvm/versions/node/v24.*/bin/node; do
  if [ -x "$candidate" ] && [ "$(major "$candidate")" -ge "$need" ]; then
    node="$candidate"
    break
  fi
done
if [ -z "$node" ]; then
  echo "Beekeep needs Node $need or newer. With nvm: nvm install 24" >&2
  exit 1
fi

exec env PATH="$(dirname "$node"):$PATH" "$node" --disable-warning=ExperimentalWarning "$entry" "$@"
