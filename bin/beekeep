#!/usr/bin/env bash
# Starts Beekeep if it is not running, then opens its screen in this terminal.
#   beekeep          the terminal screen
#   beekeep window   the full window in your browser
#   beekeep stop     stop it (bees keep their memory)
#   beekeep help     everything else
set -euo pipefail

self="${BASH_SOURCE[0]}"
while [ -L "$self" ]; do
  link="$(readlink "$self")"
  case "$link" in /*) self="$link" ;; *) self="$(dirname "$self")/$link" ;; esac
done
root="$(cd "$(dirname "$self")/.." && pwd)"

major() { "$1" -p 'process.versions.node.split(".")[0]' 2>/dev/null || echo 0; }
# The first Node at least this new, from the path or nvm.
pick() {
  for candidate in "$(command -v node || true)" "$HOME"/.nvm/versions/node/v2*/bin/node; do
    if [ -x "$candidate" ] && [ "$(major "$candidate")" -ge "$1" ]; then
      echo "$candidate"
      return 0
    fi
  done
  return 1
}

# From a clone, Beekeep runs its TypeScript as it is (Node 24 reads it directly);
# installed from npm, it runs the compiled JavaScript that comes with it.
if [ -f "$root/server/cli.ts" ] && node="$(pick 24)"; then
  entry="$root/server/cli.ts"
elif [ -f "$root/lib/server/cli.js" ] && node="$(pick 22)"; then
  entry="$root/lib/server/cli.js"
else
  echo "Beekeep needs Node 24 (or 22 for an installed package). With nvm: nvm install 24" >&2
  exit 1
fi

exec env PATH="$(dirname "$node"):$PATH" "$node" --disable-warning=ExperimentalWarning "$entry" "$@"
